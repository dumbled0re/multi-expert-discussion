{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dumbled0re/multi-expert-discussion/schemas/brief.schema.json",
  "title": "DiscussionBrief",
  "description": "Single source of truth for a discussion's goals, constraints, and panel composition.",
  "type": "object",
  "required": [
    "topic_slug", "topic", "goal", "decision_criteria",
    "risk_tolerance", "reversibility_default",
    "panel", "function_agents", "excluded"
  ],
  "properties": {
    "topic_slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,49}$" },
    "topic": { "type": "string", "minLength": 5 },
    "goal": { "type": "string", "minLength": 5 },
    "scope_in": { "type": "array", "items": { "type": "string" } },
    "scope_out": { "type": "array", "items": { "type": "string" } },
    "decision_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "weight", "direction"],
        "properties": {
          "id": { "type": "string", "pattern": "^C[0-9]+$" },
          "name": { "type": "string" },
          "weight": { "type": "integer", "minimum": 1, "maximum": 5 },
          "direction": { "type": "string", "enum": ["maximize", "minimize"] }
        }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "risk_tolerance": { "type": "string", "enum": ["low", "medium", "high"] },
    "time_horizon": { "type": "string" },
    "reversibility_default": { "type": "string", "enum": ["reversible", "hard-to-reverse", "irreversible"] },
    "known_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "fact"],
        "properties": {
          "id": { "type": "string", "pattern": "^F-[0-9]{2,3}$" },
          "fact": { "type": "string" }
        }
      }
    },
    "open_assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "assumption"],
        "properties": {
          "id": { "type": "string", "pattern": "^A-[0-9]{2,3}$" },
          "assumption": { "type": "string" },
          "how_to_verify": { "type": "string" }
        }
      }
    },
    "stakeholders_present": { "type": "array", "items": { "type": "string" } },
    "stakeholders_absent": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Whose voice is missing — the room's bias."
    },
    "panel": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "description": "Subject experts only — function agents are listed separately.",
      "items": {
        "type": "object",
        "required": ["agent", "short_code", "role", "why_chosen"],
        "properties": {
          "agent": { "type": "string", "pattern": "^expert-" },
          "short_code": { "type": "string", "pattern": "^[a-z]{2,4}$" },
          "role": { "type": "string", "enum": ["proposer", "outside", "implementer"] },
          "why_chosen": { "type": "string", "minLength": 5 },
          "model": { "type": "string", "enum": ["sonnet", "opus", "haiku"] }
        }
      }
    },
    "function_agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agent", "short_code"],
        "properties": {
          "agent": { "type": "string", "enum": ["expert-red-team", "expert-evidence-auditor"] },
          "short_code": { "type": "string", "enum": ["rt", "au"] },
          "model": { "type": "string", "enum": ["sonnet", "opus", "haiku"] }
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agent", "why_excluded"],
        "properties": {
          "agent": { "type": "string" },
          "why_excluded": { "type": "string", "minLength": 5 }
        }
      }
    }
  }
}
