{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dumbled0re/multi-expert-discussion/schemas/claims.schema.json",
  "title": "ClaimsLog",
  "description": "Audit log for a multi-expert discussion. Append-only. Revisions reference prior IDs.",
  "type": "object",
  "required": ["topic_slug", "constitution_version", "rounds_run", "claims"],
  "properties": {
    "topic_slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,49}$" },
    "constitution_version": { "type": "string", "pattern": "^v[0-9]+(\\.[0-9]+)?$" },
    "generated_at": { "type": "string", "format": "date" },
    "rounds_run": {
      "type": "array",
      "items": { "anyOf": [{ "type": "integer" }, { "type": "string", "enum": ["R"] }] }
    },
    "panel": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agent", "short_code", "role"],
        "properties": {
          "agent": { "type": "string", "pattern": "^expert-" },
          "short_code": { "type": "string", "pattern": "^[a-z]{2,4}$" },
          "role": { "type": "string", "enum": ["proposer", "outside", "implementer", "critic", "auditor"] }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/Claim" }
    },
    "questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/Question" }
    },
    "audit_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/AuditFinding" }
    },
    "ranking": {
      "type": "array",
      "description": "Round 4 final ranking with weighted Borda scores.",
      "items": {
        "type": "object",
        "required": ["claim_id", "rank", "score"],
        "properties": {
          "claim_id": { "type": "string", "pattern": "^C-[a-z]{2,4}-[0-9]{2,3}[a-z]?$" },
          "rank": { "type": "integer", "minimum": 1 },
          "score": { "type": "number" },
          "tied_with": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "Claim": {
      "type": "object",
      "required": [
        "id", "round_introduced", "expert", "status", "claim", "rationale",
        "evidence", "confidence", "falsifier", "failure_mode",
        "reversibility", "blast_radius", "impact", "cost", "horizon"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^C-[a-z]{2,4}-[0-9]{2,3}[a-z]?$" },
        "round_introduced": { "anyOf": [{ "type": "integer" }, { "type": "string", "enum": ["R"] }] },
        "expert": { "type": "string", "pattern": "^expert-" },
        "status": { "type": "string", "enum": ["active", "retired", "superseded"] },
        "supersedes": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^C-[a-z]{2,4}-[0-9]{2,3}[a-z]?$" }] },
        "superseded_by": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^C-[a-z]{2,4}-[0-9]{2,3}[a-z]?$" }] },
        "claim": { "type": "string", "minLength": 5 },
        "rationale": { "type": "string", "minLength": 5 },
        "assumptions": {
          "type": "array",
          "items": { "type": "string", "pattern": "^A-([a-z]{2,4}-)?[0-9]{2,3}$" }
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/Evidence" }
        },
        "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
        "falsifier": { "type": "string", "minLength": 3 },
        "failure_mode": { "type": "string", "minLength": 3 },
        "reversibility": { "type": "string", "enum": ["reversible", "hard-to-reverse", "irreversible"] },
        "blast_radius": { "type": "string", "enum": ["team", "product", "company", "customers", "market", "society"] },
        "impact": { "type": "string", "enum": ["H", "M", "L"] },
        "cost": { "type": "string", "enum": ["H", "M", "L"] },
        "horizon": { "type": "string", "enum": ["now", "1m", "3m", "6m+"] },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["round", "event"],
            "properties": {
              "round": { "anyOf": [{ "type": "integer" }, { "type": "string" }] },
              "event": { "type": "string", "enum": ["challenged-by", "revised", "retired", "audited", "supersede"] },
              "by": { "type": "string" },
              "to": { "type": "string" },
              "outcome": { "type": "string" },
              "diff": { "type": "string" }
            }
          }
        }
      }
    },
    "Evidence": {
      "type": "object",
      "required": ["type", "content"],
      "properties": {
        "type": { "type": "string", "enum": ["SOURCED", "USER-CONTEXT", "ANALOGY", "EXPERT-JUDGMENT", "UNVERIFIED"] },
        "content": { "type": "string", "minLength": 3 },
        "url": { "anyOf": [{ "type": "null" }, { "type": "string", "format": "uri" }] },
        "citation_quote": { "anyOf": [{ "type": "null" }, { "type": "string" }] },
        "search_date": { "anyOf": [{ "type": "null" }, { "type": "string", "format": "date" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "SOURCED" } } },
          "then": {
            "required": ["url", "citation_quote", "search_date"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "citation_quote": { "type": "string", "minLength": 3 },
              "search_date": { "type": "string", "format": "date" }
            }
          }
        }
      ]
    },
    "Question": {
      "type": "object",
      "required": ["id", "round_introduced", "raised_by", "kind", "status", "content"],
      "properties": {
        "id": { "type": "string", "pattern": "^Q-[a-z]{2,4}-[0-9]{2,3}$" },
        "round_introduced": { "anyOf": [{ "type": "integer" }, { "type": "string", "enum": ["R"] }] },
        "raised_by": { "type": "string", "pattern": "^expert-" },
        "target_claim_id": { "anyOf": [{ "type": "null" }, { "type": "string" }] },
        "kind": { "type": "string", "enum": ["challenge", "audit", "user-question", "values-conflict"] },
        "status": { "type": "string", "enum": ["open", "resolved", "accepted-as-residual-risk", "deferred-to-user"] },
        "content": { "type": "string", "minLength": 3 }
      }
    },
    "AuditFinding": {
      "type": "object",
      "required": ["id", "target_claim_id", "verdict", "severity", "recommendation"],
      "properties": {
        "id": { "type": "string", "pattern": "^Q-au-[0-9]{2,3}$" },
        "target_claim_id": { "type": "string", "pattern": "^C-[a-z]{2,4}-[0-9]{2,3}[a-z]?$" },
        "verdict": { "type": "string", "enum": ["confirmed", "confirmed-with-nuance", "unverified", "contradicting"] },
        "severity": { "type": "string", "enum": ["load-bearing", "supporting", "decorative"] },
        "recommendation": { "type": "string", "enum": ["keep", "drop", "reframe", "mark-UNVERIFIED-and-keep-non-load-bearing"] },
        "source_url": { "type": "string" },
        "citation_quote": { "type": "string" },
        "issue": { "type": "string", "enum": ["cannot-find-source", "source-does-not-say-this", "misleading-context", "exaggerated", "suspicious-specificity"] }
      }
    }
  }
}
